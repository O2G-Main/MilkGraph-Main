# Salin ke .env lalu isi. Jangan commit .env.
# Base URL dan nama model mengikuti dokumentasi Jev yang dipegang tim.
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=
# Token bersama dengan Backend, dikirim BE lewat header X-Service-Token.
# Kosong = pengecekan token mati (hanya untuk tes lokal).
SERVICE_TOKEN=
